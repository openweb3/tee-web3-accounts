# 复制成 .env 再填。cloudtest 缺 AWS 凭证时不会碰真实云；这里除了
# TEE_ACCOUNTS_USER 之外每一项都有安全默认值。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 必填，且每个操作员必须唯一：它会被打到所有创建出来的资源上，删除时精确匹配
# 这个值。两个人用同一个值就会互相删掉对方的机器。绝不要留成共享的默认值。
TEE_ACCOUNTS_USER=your-name-here

# 固定 eu-west-1（爱尔兰）：cloudtest 唯一允许启动的区域，勿改到其他区域。
# TEE_ACCOUNTS_REGION=eu-west-1

# 只支持 AMD 系列（m6a / c6a / r6a）：SEV-SNP 需要它。
# TEE_ACCOUNTS_INSTANCE_TYPE=m6a.large
